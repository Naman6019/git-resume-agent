# Option 1: Ollama Endpoint (Local or Remote with key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=your_ollama_key_if_remote

# Option 2: OpenRouter (Free Tier Qwen / LLaMA)
